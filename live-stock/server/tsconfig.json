{
  "compilerOptions": {
    /* Basic Options */
    "target": "ES6", // Target modern JavaScript (ES6+)
    "module": "commonjs", // Use CommonJS for Node.js
    "strict": true, // Enable strict type-checking
    "esModuleInterop": true, // Enable interoperability between CommonJS and ES Modules
    "forceConsistentCasingInFileNames": true, // Enforce consistent file names
    "skipLibCheck": true, // Skip type-checking in node_modules for faster builds
    "moduleResolution": "node", // Resolve modules like Node.js does
    "outDir": "./dist", // Output directory for compiled files
    "rootDir": "./src", // Specify the root folder of source files
    "resolveJsonModule": true, // Allow importing JSON files
    "sourceMap": true, // Generate .map files for debugging

    /* Type Checking */
    "strictNullChecks": true, // Enable null safety
    "strictFunctionTypes": true, // Ensure function arguments are correctly typed
    "noImplicitAny": true, // Disallow `any` unless explicitly stated
    "noUnusedLocals": true, // Report unused local variables
    "noUnusedParameters": true, // Report unused function parameters
    "noImplicitReturns": true, // Ensure all functions return a value
    "noFallthroughCasesInSwitch": true, // Prevent fallthrough in switch statements

    /* Node.js-Specific Settings */
    "types": ["node"], // Include Node.js types by default
    "lib": ["DOM", "ESNext"], // Include ES6 library for features like Promises

    /* Import Helpers */
    "importHelpers": true, // Reduce file size by reusing helper functions

    /* Additional Options */
    "incremental": true, // Enable incremental compilation for faster builds
    "removeComments": true // Remove comments in the output files
  },
  "include": ["src/**/*.ts"], // Include all files in the `src` folder
  "exclude": ["node_modules", "dist"] // Exclude unnecessary folders
}
